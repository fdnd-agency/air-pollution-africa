RESEND_API_KEY= #Spreekt voor zich
FROM_EMAIL= #Het emailadress waarvan de mails verzonden worden dit moet eindigen op het domein geconfigureerd in resend
DIRECTUS_ADMIN_TOKEN= #Personal access token for Directus server-to-server requests
DEV_SHOW_LOGIN_CODE= #DEV ONLY: set to "true" to show the login code on screen when mail isn't configured. Has no effect when NODE_ENV=production. Leave empty/unset otherwise.
