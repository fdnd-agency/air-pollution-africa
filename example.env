RESEND_API_KEY= #Your Resend API key
FROM_EMAIL= #The address mails are sent from; must be on the domain configured in Resend
DIRECTUS_ADMIN_TOKEN= #Personal access token for Directus server-to-server requests. To get a directus admin token, navigate to your user settings in the bottom left, scroll to the bottom, and generate a token. Dont forget to save the settings because otherwise the token will not yet work.
DEV_SHOW_LOGIN_CODE= #DEV ONLY: set to "true" to show the login code on screen when mail isn't configured. Has no effect when NODE_ENV=production. Leave empty/unset otherwise.
